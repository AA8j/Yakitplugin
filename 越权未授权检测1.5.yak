这是一个yaklang写的yakit的插件代码：

yakit.AutoInitYakit()

// 插件参数配置
header = cli.String(
    "header",
    cli.setVerboseName("删除的 Header Key"),
    cli.setHelp("需删除的请求头，多个用逗号(,)或竖线(|)分隔，与set-header二选一")
)
setHeader = cli.String(
    "set-header",
    cli.setVerboseName("设置/替换 Header"),
    cli.setHelp("格式: Header-Name:Header-Value，多个用逗号分隔（如Cookie:123,User-Agent:test）")
)
similarityThreshold = cli.Float(
    "similarity",
    cli.setVerboseName("相似度阈值"),
    cli.setDefault(0.8),
    cli.setHelp("判断响应体相似的阈值（0-1之间，默认0.8，值越高判定越严格）")
)
cli.check()

// 定义需要过滤的静态资源扩展名
filteredExts = []string{
    ".js", ".css", ".png", ".jpg", ".jpeg", 
    ".gif", ".ico", ".svg", ".woff", ".woff2",
    ".ttf", ".eot", ".otf"
}

// 解析需删除的请求头列表
deleteHeaders = make([]string, 0)
if header != "" {
    for _, commaPart := range str.Split(header, ",") {
        for _, pipePart := range str.Split(commaPart, "|") {
            trimmedHeader := str.TrimSpace(pipePart)
            if trimmedHeader != "" {
                deleteHeaders = append(deleteHeaders, trimmedHeader)
            }
        }
    }
}

// 解析需设置/替换的请求头（键值对）
setHeaders = make(map[string]string)
if setHeader != "" {
    for _, headerPair := range str.Split(setHeader, ",") {
        parts := str.SplitN(headerPair, ":", 2)
        if len(parts) == 2 {
            key := str.TrimSpace(parts[0])
            value := str.TrimSpace(parts[1])
            if key != "" {
                setHeaders[key] = value
            }
        }
    }
}

// 从URL中提取路径部分（去除查询参数和哈希）
getUrlPath = func(url) {
    // 去除哈希部分（#及后面的内容）
    hashIndex := str.Index(url, "#")
    if hashIndex != -1 {
        url = url[:hashIndex]
    }
    
    // 去除查询参数部分（?及后面的内容）
    queryIndex := str.Index(url, "?")
    if queryIndex != -1 {
        return url[:queryIndex]
    }
    return url
}

// 检查URL是否包含需要过滤的扩展名
shouldFilter = func(url) {
    // 获取纯路径部分（不含查询参数和哈希）
    urlPath := getUrlPath(url)
    lowerPath := str.ToLower(urlPath)
    
    // 检查路径是否包含任何需要过滤的扩展名
    for _, ext := range filteredExts {
        if str.Contains(lowerPath, ext) {
            return true
        }
    }
    return false
}

// 核心逻辑：被动重新发送请求并检测未授权访问
mirrorFilteredHTTPFlow = func(isHttps, url, req, rsp, body) {
    // 过滤静态资源请求
    if shouldFilter(url) {
        return
    }

    if len(deleteHeaders) <= 0 && len(setHeaders) <= 0 {
        return
    }

    // 记录原始响应体
    originBody := string(body)

    // 修改请求头
    modifiedReq = req
    for _, h := range deleteHeaders {
        modifiedReq = poc.DeleteHTTPPacketHeader(modifiedReq, h)
    }
    for key, value := range setHeaders {
        modifiedReq = poc.ReplaceHTTPPacketHeader(modifiedReq, key, value)
    }

    // 被动重新发送请求
    _, modifiedRsp, err := poc.HTTP(modifiedReq, poc.https(isHttps))
    if err != nil {
        yakit.Error("发送修改后请求失败: %s", err)
        return
    }

    // 直接使用modifiedRsp（[]uint8类型）作为响应体字节数组，无需调用GetAllBody
    modifiedBody := string(modifiedRsp)

    // 使用Yaklang内置函数计算响应体相似度
    similarity := str.CalcSimilarity(originBody, modifiedBody)
    similarityMatch := similarity >= similarityThreshold

    if similarityMatch {
        // 输出未授权访问漏洞信息
        yakit.Info("【未授权访问漏洞】URL: %s", url)
        yakit.Info("响应体相似度: %.2f（阈值: %.2f）", similarity, similarityThreshold)

        if len(deleteHeaders) > 0 {
            yakit.Info("已删除请求头: %v", deleteHeaders)
        }
        if len(setHeaders) > 0 {
            yakit.Info("已设置/替换请求头: %v", setHeaders)
        }

        // 保存流量到数据库
        db.SaveHTTPFlowFromRawWithOption(url, modifiedReq, modifiedRsp)
    }
}

// 空实现其他镜像函数
mirrorHTTPFlow = func(isHttps, url, req, rsp, body) {
}

mirrorNewWebsite = func(isHttps, url, req, rsp, body) {
}

mirrorNewWebsitePath = func(isHttps, url, req, rsp, body) {
}

mirrorNewWebsitePathParams = func(isHttps, url, req, rsp, body) {
}


