yakit.AutoInitYakit()

// 1. 交互式UI定义
deleteHeaders = cli.String(
    "delete_headers",
    cli.setVerboseName("删除的请求头 (逗号分隔)"),
    cli.setHelp("例如: User-ID,Token,X-User-Type"),
)
setHeaders = cli.String(
    "set_headers",
    cli.setVerboseName("设置/修改的请求头"),
    cli.setHelp(`格式: "Key1:Value1,Key2:Value2", 例如: "Authorization:,Cookie:"`),
)
similarityThreshold = cli.Float(
    "similarity",
    cli.setVerboseName("响应体相似度阈值"),
    cli.setDefault(0.95),
    cli.setHelp("当相似度高于此值时报告漏洞，范围 0.0-1.0"),
)

cli.check()

if deleteHeaders == "" && setHeaders == "" {
    die("错误：请至少填写 '删除的请求头' 或 '设置/修改的请求头' 中的一项。")
}

// 预处理用户输入的 Headers
deleteHeaderKeys := str.Split(deleteHeaders, ",")
setHeaderMap := make(map[string]string)
if setHeaders != "" {
    pairs := str.Split(setHeaders, ",")
    for _, pair := range pairs {
        kv := str.SplitN(pair, ":", 2)
        if len(kv) == 2 {
            key := str.TrimSpace(kv[0])
            val := str.TrimSpace(kv[1])
            if key != "" {
                setHeaderMap[key] = val
            }
        }
    }
}

staticFileExtensions := [
    ".js", ".css", ".png", ".jpg", ".jpeg", ".gif", ".svg", ".ico",
    ".woff", ".woff2", ".ttf", ".eot", ".map", ".webp", ".mp4", ".mp3",
    ".webm", ".ogg", ".wav", ".flac", ".aac",
]

mirrorFilteredHTTPFlow = func(isHttps /*bool*/, url /*string*/, req /*[]byte*/, rsp /*[]byte*/, body /*[]byte*/) {
    if len(deleteHeaderKeys) == 0 && len(setHeaderMap) == 0 {
        return
    }

    pathWithoutQuery := poc.GetHTTPRequestPathWithoutQuery(req)
    for _, ext := range staticFileExtensions {
        if str.EndsWith(str.ToLower(pathWithoutQuery), ext) {
            return
        }
    }

    modifiedReq := append([]byte(nil), req...)
    modifiedHeadersInfo := []string{}

    for _, headerKey := range deleteHeaderKeys {
        key := str.TrimSpace(headerKey)
        if key != "" {
            modifiedReq = poc.DeleteHTTPPacketHeader(modifiedReq, key)
            modifiedHeadersInfo.Append(str.f("删除: %s", key))
        }
    }

    for key, value := range setHeaderMap {
        modifiedReq = poc.ReplaceHTTPPacketHeader(modifiedReq, key, value)
        modifiedHeadersInfo.Append(str.f("设置: %s: %s", key, value))
    }
    
    if len(modifiedHeadersInfo) == 0 {
        return
    }

    freq, err := fuzz.HTTPRequest(modifiedReq, fuzz.https(isHttps))
    if err != nil {
        yakit.Error("创建重放请求失败: %v", err)
        return
    }
    
    result := freq.ExecFirst()~
    if result.Error != nil {
        yakit.Warn("重放请求失败 [%s]: %v", url, result.Error)
        return
    }

    // 关键逻辑修正：
    // 1. 获取原始响应和新响应的状态码
    originalStatusCode := poc.GetStatusCodeFromResponse(rsp)
    newStatusCode := poc.GetStatusCodeFromResponse(result.ResponseRaw)

    // 2. 首先判断状态码是否一致，如果不一致，则说明访问控制生效，直接跳过
    if originalStatusCode != newStatusCode {
        return
    }

    // 3. 如果状态码一致，再进行内容相似度比较
    originalBody, err := str.ExtractBodyFromHTTPResponseRaw(rsp)
    if err != nil { return }
    newBody, err := str.ExtractBodyFromHTTPResponseRaw(result.ResponseRaw)
    if err != nil { return }

    similarity := str.CalcSimilarity(string(originalBody), string(newBody))
    
    if similarity >= similarityThreshold {
        risk.NewRisk(
            result.Url,
            risk.title(str.f("疑似未授权或越权访问: %s", result.Url)),
            risk.payload(str.Join(modifiedHeadersInfo, ", ")),
            risk.severity("high"),
            risk.description(str.f(
                "通过修改或删除请求头 [%s] 后重新请求，服务器返回的响应状态码与原始响应码一致(%d)，且响应内容基本一致 (相似度: %.2f%%)，可能存在未授权或越权访问漏洞。",
                str.Join(modifiedHeadersInfo, ", "),
                originalStatusCode,
                similarity*100,
            )),
            risk.solution("对需要身份验证和授权的接口进行严格的访问控制检查，确保即使在缺少或伪造关键请求头的情况下，也无法访问受保护的资源。"),
            risk.type("未授权访问"),
            risk.request(result.RequestRaw),
            risk.response(result.ResponseRaw),
        )
    }
}

// 保持插件结构完整
mirrorHTTPFlow = func(isHttps /*bool*/, url /*string*/, req /*[]byte*/, rsp /*[]byte*/, body /*[]byte*/) {}
mirrorNewWebsite = func(isHttps /*bool*/, url /*string*/, req /*[]byte*/, rsp /*[]byte*/, body /*[]byte*/) {}
mirrorNewWebsitePath = func(isHttps /*bool*/, url /*string*/, req /*[]byte*/, rsp /*[]byte*/, body /*[]byte*/) {}
mirrorNewWebsitePathParams = func(isHttps /*bool*/, url /*string*/, req /*[]byte*/, rsp /*[]byte*/, body /*[]byte*/) {}